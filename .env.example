# =============================================================================
# Debug Dynasty — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local overrides. DO NOT commit real secrets or .env.
# Render dashboard: Enter these environment variables under Service Settings -> Environment.

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client Bundle)
# NOTE: Variables prefixed with VITE_ are embedded into the client browser bundle.
# NEVER put private API secrets, database credentials, or auth keys in VITE_ variables!
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL:
# - Leave EMPTY for Single-Service deployment (FastAPI serves both API and static frontend).
# - Set to your deployed backend URL (e.g. https://debug-dynasty-api.onrender.com)
#   ONLY if deploying frontend separately as a Render Static Site.
# - DO NOT include a trailing slash or '/api'.
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Port assigned dynamically by Render (Render injects $PORT automatically, e.g. 10000).
# For local development, defaults to 8000.
PORT=8000

# Server host interface. Defaults to 0.0.0.0 in production / when PORT is set.
HOST=0.0.0.0

# Cryptographic HMAC key for signing user authentication tokens.
# Generate a strong 32+ character random string for production.
AUTH_SECRET_KEY=replace_with_a_secure_random_32_char_secret_key_in_production

# -----------------------------------------------------------------------------
# 3. CORS ORIGINS (For separate frontend & backend deployments)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Render domains (*.onrender.com) and localhost are automatically allowed by default.
# Example: https://debug-dynasty.onrender.com,https://yourcustomdomain.com
ALLOWED_ORIGINS=https://debug-dynasty.onrender.com

# -----------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# -----------------------------------------------------------------------------
# Path to SQLite database file. Defaults to ./debugger.db in repository root.
# On Render's free tier, the filesystem is ephemeral (resets on restart/deploy).
# If you attach a persistent Render Disk, point DB_PATH to the mount directory.
# Example with Render Disk mounted at /var/data:
# DB_PATH=/var/data/debugger.db
DB_PATH=debugger.db

# -----------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Supported values:
# - mock      : Built-in multi-stage AST analysis & heuristic engine (Default).
#               Requires NO API KEY and works completely offline/free!
# - openai    : Uses OpenAI models (Requires OPENAI_API_KEY).
# - gemini    : Uses Google Gemini models (Requires GEMINI_API_KEY).
# - anthropic : Uses Anthropic Claude models (Requires ANTHROPIC_API_KEY).
AI_PROVIDER=mock

# AI API Keys (OPTIONAL - only needed if AI_PROVIDER is set to the matching provider):
# If an API key is missing or invalid, the engine gracefully falls back to mock mode.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
