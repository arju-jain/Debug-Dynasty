# Debug Dynasty Environment Configuration
# Note: Vite environment variables prefixed with VITE_ are embedded into the client bundle
# and are publicly exposed to the browser. DO NOT store private API secrets or tokens here.

# Leave VITE_API_BASE_URL empty for single-URL mode (via Vite dev proxy or FastAPI single server)
# Only specify a full URL (e.g. http://192.168.1.50:8000) for cross-machine network deployments.
VITE_API_BASE_URL=
